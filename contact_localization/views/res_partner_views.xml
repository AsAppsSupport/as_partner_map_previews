<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_map_preview" model="ir.ui.view">
        <field name="name">res.partner.form.map.preview</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_geolocalize.view_crm_partner_geo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='geo_localize_button']" position="after">
                <field
                    name="partner_latitude"
                    widget="map_preview"
                    nolabel="1"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>